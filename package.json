    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@iconify-json/carbon": "^1.2.28",
    "@tsconfig/node20": "^20.1.10",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/nprogress": "^0.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
