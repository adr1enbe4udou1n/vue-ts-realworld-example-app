    "@vueuse/head": "^2.0.0",
    "marked": "^18.0.9",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@iconify-json/carbon": "^1.2.25",
    "@tsconfig/node20": "^20.1.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/nprogress": "^0.2.3",
    "@unocss/reset": "66.7.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/compiler-dom": "^3.5.41",
